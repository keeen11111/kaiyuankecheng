# ===== Git 忽略规则：只把源码、配置模板、脚本与文档推到 GitHub =====
# 注意：gitignore 不支持行尾注释，注释必须独占一行，否则规则会被当成含 # 的模式而失效。
# 说明：config.yaml 里只有 ${ENV_VAR} 占位符，没有明文密钥，因此可以入库；真实密钥由环境变量注入。

# Python 字节码缓存，不属于交付物
__pycache__/
*.py[cod]
*.egg-info/

# 本地虚拟环境
.venv/
venv/

# 本地环境变量文件，可能含密钥，绝不入库
.env
.env.*

# SQLite 运行库、检测日志与临时文件，含真实业务数据，整目录不入库
data/
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite*
*.log

# 本地工作区记忆与内部数据，不推送到公开仓库
.workbuddy/

# 测试与类型检查缓存
.pytest_cache/
.mypy_cache/

# 操作系统元数据
.DS_Store
Thumbs.db
